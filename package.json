{
  "name": "@thenavidm/op3-mcp-cli",
  "version": "1.2.0",
  "description": "OP3 MCP server and CLI for Claude Code, Codex and AI agents. 22 tools for open podcast analytics: downloads, unique listeners, retention, geography, app and device share, listening patterns and episode curves.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "op3-mcp": "dist/index.js",
    "op3-cli": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "check:published": "node scripts/check-published.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/op3-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/op3-mcp-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "op3",
    "podcast",
    "podcast-analytics",
    "podcast-stats",
    "prefix-analytics",
    "open-podcast-prefix-project",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools",
    "cli",
    "command-line-tool"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "contributors": [
    "Navid Moazzez (https://navid.me)"
  ]
}
